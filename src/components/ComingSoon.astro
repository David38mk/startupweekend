---
interface Props {
  message: string;
}

const { message } = Astro.props;
---

<div
  class="rounded-2xl border-2 border-dashed border-brand/30 bg-brand-light/50 px-6 py-16 text-center"
>
  <p class="font-slab text-2xl font-semibold text-brand">Coming soon</p>
  <p class="mx-auto mt-2 max-w-md text-neutral-600">{message}</p>
</div>
