---
import speakers from '../data/speakers.json';
import ComingSoon from './ComingSoon.astro';

interface Speaker {
  name: string;
  role: string;
  organization: string;
  photo?: string;
}

const list = speakers as Speaker[];
---

<section id="speakers" class="scroll-mt-20 bg-neutral-50 py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <h2 class="font-slab text-3xl font-bold text-brand sm:text-4xl">Speakers &amp; Mentors</h2>
    <p class="mt-2 text-lg text-neutral-600">
      Facilitators, judges, and mentors guiding you through the weekend.
    </p>
    <div class="mt-8">
      {list.length === 0 ? (
        <ComingSoon message="We are lining up an amazing crew of facilitators, judges, and mentors. Announcements coming soon." />
      ) : (
        <ul class="grid grid-cols-2 gap-6 sm:grid-cols-3 lg:grid-cols-4">
          {list.map((speaker) => (
            <li class="rounded-2xl bg-white p-5 text-center shadow-sm">
              {speaker.photo && (
                <img
                  src={speaker.photo}
                  alt={speaker.name}
                  class="mx-auto h-24 w-24 rounded-full object-cover"
                  loading="lazy"
                />
              )}
              <div class="mt-3 font-bold">{speaker.name}</div>
              <div class="text-sm font-medium text-accent">{speaker.role}</div>
              <div class="text-sm text-neutral-600">{speaker.organization}</div>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>
