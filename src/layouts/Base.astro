---
import '../styles/global.css';
import event from '../data/event.json';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = event.name,
  description = `${event.name} — a 3-day startup hackathon in ${event.venue.city}. Pitch ideas, build teams, launch a startup in 54 hours.`,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-white font-sans text-neutral-900 antialiased">
    <slot />
  </body>
</html>
